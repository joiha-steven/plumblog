#!/usr/bin/env bash
# Builds the admin (web/admin) into target/admin: tsc type-checks, esbuild bundles, then the
# size budgets (docs/ARCHITECTURE.md, Budgets) are enforced. The output is never committed;
# releases ship it like the Worker wasm (issue #21).
#   scripts/admin-build         the real client, talking to the Worker's API
#   scripts/admin-build --dev   the mock client (web/admin/src/api/mock.ts), for scripts/admin-dev
set -euo pipefail
cd "$(dirname "$0")/.."

# Budgets, gzip -9 bytes. Shell: what every admin page loads. Chunks: each lazily loaded part
# (the editor lands as one). CSS: the whole admin stylesheet.
SHELL_JS_BUDGET=$((35 * 1024))
CHUNK_JS_BUDGET=$((110 * 1024))
CSS_BUDGET=$((20 * 1024))

fail() { echo "admin-build: FAIL: $1" >&2; exit 1; }
mock=false
[ "${1:-}" = "--dev" ] && mock=true

scripts/tools-install
bin=tools/node_modules/.bin
"$bin/tsc" -p web/admin/tsconfig.json || fail "type errors in web/admin/src (above)"
"$bin/tsc" -p web/admin/tsconfig.sw.json || fail "type errors in web/admin/src/sw.ts (above)"

out=target/admin
rm -rf "$out"
mkdir -p "$out"
common=(--bundle --minify --target=es2022 --legal-comments=none --log-level=warning --charset=utf8)
"$bin/esbuild" web/admin/src/main.ts "${common[@]}" --format=esm --splitting \
  --outdir="$out" --entry-names=app --chunk-names='chunks/[name]-[hash]' --define:MOCK="$mock" \
  || fail "esbuild: admin script"
"$bin/esbuild" web/admin/src/sw.ts "${common[@]}" --format=iife --outfile="$out/sw.js" \
  || fail "esbuild: service worker"
"$bin/esbuild" web/admin/src/app.css "${common[@]}" --outfile="$out/app.css" \
  || fail "esbuild: admin stylesheet"

gz() { gzip -9 -c "$1" | wc -c | tr -d ' '; }
over=""
check_size() { # file budget label
  local size; size=$(gz "$1")
  echo "admin-build: $3 $(basename "$1") gzip = $size bytes (budget $2)"
  [ "$size" -le "$2" ] || over+="$3 $(basename "$1") $size > $2; "
}
check_size "$out/app.js" "$SHELL_JS_BUDGET" "shell"
for f in "$out"/chunks/*.js; do [ -e "$f" ] && check_size "$f" "$CHUNK_JS_BUDGET" "chunk"; done
check_size "$out/app.css" "$CSS_BUDGET" "css"
[ -z "$over" ] || fail "over budget: $over"
