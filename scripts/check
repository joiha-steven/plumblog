#!/usr/bin/env bash
# The ONE check: every rule of this repo that a machine can verify lives here.
set -euo pipefail
cd "$(dirname "$0")/.."

WASM_GZIP_BUDGET_BYTES=$((1024 * 1024)) # Workers free plan allows 3 MiB gzipped; keep headroom.
WASM_FILE="${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/plumblog_worker.wasm"

fail() { echo "check: FAIL: $1" >&2; exit 1; }
step() { echo "check: $1"; }

# 1. Self-heal the hook so commits always run this script.
if [ "$(git config core.hooksPath || true)" != "scripts/hooks" ]; then
  git config core.hooksPath scripts/hooks
  step "set core.hooksPath=scripts/hooks"
fi

step "fmt"
cargo fmt --all --check || fail "rustfmt: run 'cargo fmt --all'"

step "clippy (host: every crate but worker)"
cargo clippy -q --workspace --exclude plumblog-worker --all-targets -- -D warnings \
  || fail "clippy found warnings in host crates"
step "clippy (wasm: worker)"
cargo clippy -q -p plumblog-worker --target wasm32-unknown-unknown --all-targets -- -D warnings \
  || fail "clippy found warnings in worker"

step "test (all crates)"
cargo test -q --workspace || fail "tests failed"

step "worker wasm build + size budget"
cargo build -q -p plumblog-worker --target wasm32-unknown-unknown --release \
  || fail "worker wasm build failed"
size=$(gzip -9 -c "$WASM_FILE" | wc -c | tr -d ' ')
echo "check: worker.wasm gzip = $size bytes (budget $WASM_GZIP_BUDGET_BYTES)"
[ "$size" -le "$WASM_GZIP_BUDGET_BYTES" ] || fail "worker wasm gzip $size > budget $WASM_GZIP_BUDGET_BYTES"

# --- crate dependency graph (issue #1) ---
step "crate dependency graph"
command -v jq > /dev/null || fail "jq is missing; install it (macOS: brew install jq, Debian/Ubuntu: apt install jq)"
# Modules stay replaceable only if dependencies point down the list in docs/ARCHITECTURE.md
# (Code layout); that list is the single source of the allowed order.
order=$(awk '/^## Code layout/{s=1} s&&/^```/{n++; next} s&&n==1&&/^crates\//{split($1,a,"/"); print a[2]} n>=2{exit}' docs/ARCHITECTURE.md)
[ -n "$order" ] || fail "no crates/ list found under '## Code layout' in docs/ARCHITECTURE.md"
# External crates each module may use. Empty for most: a module crate gains an external
# dependency only by adding a line here with its reason, so runtime crates (worker-sys,
# web-sys, js-sys, wasm-bindgen, reqwest...) cannot slip into logic that must test on the host.
external_allowlist='
worker   worker                 # the Cloudflare runtime; the only crate that does I/O
cli      clap                   # argument parsing for the `blog` binary
markdown unicode-normalization  # NFC before heading ids (pure Rust, no I/O)
store unicode-normalization  # in-memory search folds diacritics like FTS5 unicode61
'
meta=$(cargo metadata -q --format-version 1 --no-deps) || fail "cargo metadata failed"
graph_errors=$(jq -r --arg order "$order" --arg allow "$external_allowlist" '
  ($order | split("\n") | map(select(. != ""))) as $o
  | ($allow | split("\n") | map(sub("#.*"; "") | [splits("[ \t]+")] | map(select(. != "")))
      | map(select(length == 2) | "\(.[0]) \(.[1])")) as $allowed
  | (.packages | map({key: (.manifest_path | split("/") | .[-2]), value: .}) | from_entries) as $pkgs
  | (.packages | map({key: .name, value: (.manifest_path | split("/") | .[-2])}) | from_entries) as $dir
  | ($pkgs | keys[] | . as $k | select(($o | index($k)) == null) | "  crates/\(.) is a workspace member but not listed in Code layout"),
    ($o[] | select($pkgs[.] == null) | "  crates/\(.) is listed in Code layout but is not a workspace member"),
    ($pkgs | to_entries[] | .key as $from | ($o | index($from)) as $i | select($i != null)
      | .value.dependencies[] | select($dir[.name] != null) | $dir[.name] as $to
      | ($o | index($to)) as $j | select($j != null and $j >= $i)
      | "  crates/\($from) -> crates/\($to): may only depend on crates listed above it"),
    ($pkgs | to_entries[] | .key as $from
      | .value.dependencies[] | select($dir[.name] == null) | .name as $ext
      | select(($allowed | index("\($from) \($ext)")) == null)
      | "  crates/\($from) -> \($ext): external crate not in the allowlist in scripts/check")
' <<< "$meta") || fail "jq failed while reading cargo metadata"
if [ -n "$graph_errors" ]; then echo "$graph_errors"; fail "crate dependency graph (see docs/ARCHITECTURE.md, Code layout)"; fi
# --- end crate dependency graph ---

# Own block: the real Worker over HTTP under local wrangler (about 5 s warm). Needs Node.
step "worker integration (wrangler dev, local D1/R2)"
scripts/worker-test || fail "worker integration tests (run scripts/worker-test for details)"

# Files git would track: tracked + untracked, minus ignored, minus deleted.
# Written to a file first so a git failure fails the check instead of vanishing in a pipe.
list_file=$(mktemp)
trap 'rm -f "$list_file"' EXIT
git -c core.quotePath=false ls-files -z --cached --others --exclude-standard > "$list_file" \
  || fail "git ls-files failed"
files=()
while IFS= read -r -d '' f; do [ -f "$f" ] && files+=("$f"); done < "$list_file"

step "markdown allowlist"
bad=""
for f in "${files[@]}"; do
  case "$f" in
    README.md|AGENTS.md|CLAUDE.md|CHANGELOG.md|docs/ARCHITECTURE.md) ;;
    guides/*/*) case "$f" in *.md) bad+="$f "; echo "  guides must be top level: $f" ;; esac ;;
    guides/*.md) ;;
    # Repeated workflows (3+ times) become skills; one SKILL.md per skill folder, nothing else.
    .claude/skills/*/*/*) case "$f" in *.md) bad+="$f "; echo "  skills are one folder deep: $f" ;; esac ;;
    .claude/skills/*/SKILL.md) ;;
    *.md) bad+="$f "; echo "  not allowed: $f" ;;
  esac
done
[ -z "$bad" ] || fail "markdown outside allowlist (fixed files, top-level guides/*.md, .claude/skills/<name>/SKILL.md): $bad"

step "english-only paths"
bad=""
for f in "${files[@]}"; do
  case "$f" in
    README.md|AGENTS.md|CLAUDE.md|CHANGELOG.md|LICENSE|Cargo.toml|Cargo.lock|docs/ARCHITECTURE.md) continue ;;
  esac
  case "$f" in *$'\n'*) bad+="newline-in-path "; echo "  bad path (newline): ${f//$'\n'/\\n}"; continue ;; esac
  rc=0
  printf '%s' "$f" | LC_ALL=C grep -Eq '^([a-z0-9._-]+/)*[a-z0-9._-]+$|^crates/[a-z0-9_-]+/Cargo\.toml$|^\.claude/skills/[a-z0-9-]+/SKILL\.md$' || rc=$?
  [ "$rc" -le 1 ] || fail "grep error while checking path $f"
  # Cargo.toml only passes as the exact crate manifest; any other uppercase fails the first regex.
  if [ "$rc" -eq 1 ]; then bad+="$f "; echo "  bad path: $f"; fi
done
[ -z "$bad" ] || fail "paths must match ^[a-z0-9._/-]+\$: $bad"

step "english-only source"
bad=""
for f in "${files[@]}"; do
  # Themes ship their own UI text (themes/<name>/locales/), so a theme zip is self-contained.
  case "$f" in locales/*|guides/*|themes/*/locales/*|LICENSE) continue ;; esac
  rc=0
  # -I skips binary files; the class allows printable ASCII plus whitespace.
  hits=$(LC_ALL=C grep -nI '[^ -~[:space:]]' "$f") || rc=$?
  [ "$rc" -le 1 ] || fail "grep error while scanning $f"
  if [ "$rc" -eq 0 ]; then bad+="$f "; echo "$hits" | sed "s|^|  $f:|" | cut -c1-120; fi
done
[ -z "$bad" ] || fail "non-ASCII characters outside locales/, themes/*/locales/ and guides/: $bad"

step "no uppercase styling in web/ and themes/"
# All-caps and small-caps are hard to read, worst for Vietnamese diacritics; write words in normal case.
bad=""
for f in "${files[@]}"; do
  case "$f" in web/*.css|web/*.html|themes/*.css|themes/*.html) ;; *) continue ;; esac
  rc=0
  hits=$(grep -nEi 'text-transform[[:space:]]*:[[:space:]]*(uppercase|capitalize)|font-variant(-caps)?[[:space:]]*:[^;}]*small-caps' "$f") || rc=$?
  [ "$rc" -le 1 ] || fail "grep error while scanning $f"
  if [ "$rc" -eq 0 ]; then bad+="$f "; echo "$hits" | sed "s|^|  $f:|" | cut -c1-140; fi
done
[ -z "$bad" ] || fail "uppercase or small-caps styling (see docs/ARCHITECTURE.md, Design language): $bad"

step "admin CSS: raw values only in tokens.css, components defined once"
scripts/check-admin-css web/admin/css || fail "admin CSS rules (see scripts/check-admin-css for why)"

step "doc length limits"
# Long docs drift and get skimmed; a hard cap forces saying each thing once.
bad=""
limit_for() {
  case "$1" in
    AGENTS.md|guides/*.md) echo 60 ;;
    .claude/skills/*/SKILL.md) echo 120 ;;
    README.md) echo 80 ;;
    CLAUDE.md) echo 1 ;;
    *) echo "" ;;
  esac
}
for f in "${files[@]}"; do
  max=$(limit_for "$f")
  [ -n "$max" ] || continue
  n=$(wc -l < "$f" | tr -d " ")
  if [ "$n" -gt "$max" ]; then bad+="$f "; echo "  $f: $n lines (max $max)"; fi
done
[ -z "$bad" ] || fail "docs over their line limit; cut repetition: $bad"

step "dependencies only via workspace"
manifests=()
for f in "${files[@]}"; do [ "$(basename "$f")" = "Cargo.toml" ] && manifests+=("$f"); done
bad=""
for f in "${manifests[@]}"; do
  out=$(awk -v file="$f" '
    function strip(l,   i, c, q, r) {  # drop a trailing # comment that is outside quotes
      q = ""; r = ""
      for (i = 1; i <= length(l); i++) {
        c = substr(l, i, 1)
        if (q == "" && c == "#") break
        if (q == "" && (c == "\"" || c == "\x27")) q = c
        else if (q != "" && c == q) q = ""
        r = r c
      }
      return r
    }
    function flush() { if (sub_name != "" && !sub_ok) print file ": [" sub_name "] needs workspace = true"; sub_name = "" }
    {
      line = strip($0); gsub(/[ \t\r]/, "", line)
      if (line == "") next
      if (line ~ /^\[/) {
        flush()
        h = line; gsub(/^\[+|\]+$/, "", h)
        dep = 0; sub_name = ""
        if (h ~ /^(target\..*\.)?(dev-|build-)?dependencies$/) dep = 1
        else if (h ~ /^(target\..*\.)?(dev-|build-)?dependencies\./) { sub_name = h; sub_ok = 0 }
        next
      }
      if (sub_name != "") { if (line ~ /^workspace=true$/) sub_ok = 1; next }
      if (!dep) {
        if (line ~ /^(dev-|build-)?dependencies[.=]/ || line ~ /^target\./) print file ":" NR ": use a [dependencies] table: " $0
        next
      }
      v = line; gsub(/"[^"]*"/, "\"\"", v); gsub(/\x27[^\x27]*\x27/, "\x27\x27", v)
      if (v ~ /^[A-Za-z0-9_-]+\.workspace=true$/) next
      if (v ~ /^[A-Za-z0-9_-]+=\{.*[{,]workspace=true[,}].*\}$/ || v ~ /^[A-Za-z0-9_-]+=\{workspace=true\}$/) next
      print file ":" NR ": " $0
    }
    END { flush() }
  ' "$f") || fail "awk failed on $f"
  if [ -n "$out" ]; then bad+="$f "; echo "$out" | sed 's/^/  /'; fi
done
[ -z "$bad" ] || fail "dependency not using workspace = true: $bad"

echo "check: all passed"
