#!/usr/bin/env bash
# Worker integration tests: the real wasm under `wrangler dev` with local D1/R2, over HTTP.
# Contributor-only; needs Node (pinned tools live in tools/). Run by scripts/check and CI.
set -euo pipefail
cd "$(dirname "$0")/.."

fail() { echo "worker-test: FAIL: $1" >&2; exit 1; }

# --serve: build like the tests, then keep the Worker running for a person to click through
# (scripts/admin-dev). --admin-prebuilt: use target/admin as scripts/check just built it.
# Tests and --serve build into separate dirs, so a test run never swaps files under a
# running scripts/admin-dev: target/worker-test for tests, target/worker-dev (what
# tools/wrangler.dev.toml names) for --serve.
serve=false
admin_prebuilt=false
for a in "$@"; do
  case "$a" in
    --serve) serve=true ;;
    --admin-prebuilt) admin_prebuilt=true ;;
    *) fail "unknown argument $a" ;;
  esac
done
if $serve; then out=target/worker-dev; else out=target/worker-test; fi

# Pinned Node tools (wrangler, esbuild...) from tools/package-lock.json.
scripts/tools-install || fail "contributor tools (above)"

# The admin (scripts/admin-build), served with the mock API when a person clicks through,
# since the posts and media APIs do not exist yet. Assets laid out as a deploy ships them.
if $serve; then
  scripts/admin-build --dev || fail "admin build (above)"
  admin_dir=target/admin-dev
else
  $admin_prebuilt || scripts/admin-build || fail "admin build (above)"
  admin_dir=target/admin
fi
# The Worker's HTML shell preloads the chunks this build lists, so the admin is built first
# (crates/worker/build.rs; a stale list is caught by admin.test.mjs).
export PLUMBLOG_ADMIN_PRELOAD="$PWD/$admin_dir.preload"

# Pinned worker-build (scripts/worker-build installs it on first use).
wb=$(scripts/worker-build) || fail "worker-build unavailable"

# Build once here: node --test runs each file in its own process, in parallel.
# --no-opt: wasm-opt is for deploy size; tests want the fastest correct build.
# Arguments after `--` go to cargo build. contract-tests adds the /__contract route, which
# empties the database to run the store contract suite on D1. Its own target dir keeps that
# wasm away from target/wasm32-unknown-unknown/release, the deploy and size-budget build.
contract_target="$PWD/target/contract-tests"
(cd crates/worker && "$wb" --release --no-opt --out-dir "../../$out" \
  -- --features contract-tests --target-dir "$contract_target") \
  || fail "worker-build failed"

scripts/worker-entry "$out" || fail "worker entry (above)"
scripts/assemble-assets "$out/assets" "$admin_dir" || fail "assembling assets (above)"

if $serve; then
  port="${PORT:-8790}"
  state=target/worker-dev/state
  wr=tools/node_modules/.bin/wrangler
  "$wr" d1 migrations apply DB --local --config tools/wrangler.dev.toml --persist-to "$state" >/dev/null \
    || fail "applying migrations to the local D1"
  echo "worker-test: serving http://localhost:$port/admin/ (Ctrl-C stops)"
  exec "$wr" dev --config tools/wrangler.dev.toml --persist-to "$state" --ip 127.0.0.1 --port "$port"
fi

# The harness cleans up after itself, even on Ctrl-C. This trap is the second line of
# defence: kill any wrangler process group it recorded and remove its temp state.
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/plumblog-worker-test.XXXXXX")
cleanup() {
  for f in "$run_dir"/*.pgid; do
    [ -e "$f" ] || continue
    pgid=$(basename "$f" .pgid)
    kill -KILL -- "-$pgid" 2>/dev/null || true
  done
  rm -rf "$run_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

WORKER_TEST_RUN_DIR="$run_dir" WORKER_TEST_OUT="$PWD/$out" node tools/worker-test/run.mjs \
  || fail "Worker integration tests failed"
