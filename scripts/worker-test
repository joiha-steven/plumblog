#!/usr/bin/env bash
# Worker integration tests: the real wasm under `wrangler dev` with local D1/R2, over HTTP.
# Contributor-only; needs Node (pinned tools live in tools/). Run by scripts/check and CI.
set -euo pipefail
cd "$(dirname "$0")/.."

NODE_MAJOR_MIN=22

fail() { echo "worker-test: FAIL: $1" >&2; exit 1; }

command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 \
  || fail "Node.js $NODE_MAJOR_MIN+ with npm is required for Worker tests (contributors only). Install it from https://nodejs.org or with your package manager, then rerun."
major=$(node -p 'process.versions.node.split(".")[0]')
[ "$major" -ge "$NODE_MAJOR_MIN" ] || fail "Node.js $NODE_MAJOR_MIN+ is required, found $(node -v). Upgrade Node, then rerun."

# Pinned wrangler from tools/package-lock.json; reinstall only when the lockfile changed.
stamp=tools/node_modules/.lock-stamp
if ! cmp -s tools/package-lock.json "$stamp" 2>/dev/null; then
  echo "worker-test: npm ci in tools/ (first run or lockfile change only)"
  npm ci --prefix tools --no-audit --no-fund --loglevel=error || fail "npm ci in tools/ failed"
  cp tools/package-lock.json "$stamp"
fi

# Pinned worker-build (scripts/worker-build installs it on first use).
wb=$(scripts/worker-build) || fail "worker-build unavailable"

# Build once here: node --test runs each file in its own process, in parallel.
# --no-opt: wasm-opt is for deploy size; tests want the fastest correct build.
# Arguments after `--` go to cargo build. contract-tests adds the /__contract route, which
# empties the database to run the store contract suite on D1. Its own target dir keeps that
# wasm away from target/wasm32-unknown-unknown/release, the deploy and size-budget build.
contract_target="$PWD/target/contract-tests"
(cd crates/worker && "$wb" --release --no-opt --out-dir ../../target/worker-dev \
  -- --features contract-tests --target-dir "$contract_target") \
  || fail "worker-build failed"

# Static assets the Worker's pages link to (crates/worker/src/pages THEME_ASSETS_URL).
rm -rf target/worker-dev/assets
mkdir -p target/worker-dev/assets/theme
cp -R themes/minimal/assets target/worker-dev/assets/theme/minimal
# Bundled plugins' assets at PLUGIN_ASSETS_URL (/plugin/<name>/).
for dir in plugins/*/; do
  [ -d "$dir/assets" ] || continue
  name=$(basename "$dir")
  mkdir -p target/worker-dev/assets/plugin
  cp -R "$dir/assets" "target/worker-dev/assets/plugin/$name"
done

# The harness cleans up after itself, even on Ctrl-C. This trap is the second line of
# defence: kill any wrangler process group it recorded and remove its temp state.
run_dir=$(mktemp -d "${TMPDIR:-/tmp}/plumblog-worker-test.XXXXXX")
cleanup() {
  for f in "$run_dir"/*.pgid; do
    [ -e "$f" ] || continue
    pgid=$(basename "$f" .pgid)
    kill -KILL -- "-$pgid" 2>/dev/null || true
  done
  rm -rf "$run_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

WORKER_TEST_RUN_DIR="$run_dir" node --test "tools/worker-test/*.test.mjs" \
  || fail "Worker integration tests failed"
